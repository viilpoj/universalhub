local antiAfkRunning = false
local antiAfkConnection = nil

local function startAntiAfk()
    if antiAfkRunning then return end
    antiAfkRunning = true
    
    AfkStatus.TextColor3 = Theme.Success
    AfkStatus.Text = "ANTI-AFK  ✓"
    AfkToggle.Text = "ATIVADO"
    AfkGradient.Color = gradOn()
    
    pcall(function()
        player.Idled:Connect(function()
            if not antiAfkRunning then return end
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end)
    end)
    
    if antiAfkConnection then antiAfkConnection:Disconnect() end
    antiAfkConnection = task.spawn(function()
        while antiAfkRunning do
            task.wait(CONFIG.AntiAfkInterval)
            if not antiAfkRunning then break end
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        end
    end)
end

local function stopAntiAfk()
    antiAfkRunning = false
    AfkStatus.TextColor3 = Theme.Text
    AfkStatus.Text = "ANTI-AFK"
    AfkToggle.Text = "DESATIVADO"
    AfkGradient.Color = gradOff()
    if antiAfkConnection then
        pcall(task.cancel, antiAfkConnection)
        antiAfkConnection = nil
    end
end

