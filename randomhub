UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        changeSpeed(input.Position.Z * CONFIG.StepSize)
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if listeningFor then
        if input.KeyCode == Enum.KeyCode.Unknown then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            local btn = KeybindLabels[listeningFor]
            if btn then
                if Keybinds[listeningFor] == Enum.KeyCode.Unknown then
                    btn.Text = "Nenhuma"
                    btn.TextColor3 = Theme.TextDim
                else
                    btn.Text = Keybinds[listeningFor].Name
                    btn.TextColor3 = Theme.Accent2
                end
                tween(btn, {BackgroundColor3 = Theme.BgSecondary}, 0.15)
            end
            listeningFor = nil
            return
        end
        local oldKey = listeningFor
        Keybinds[oldKey] = input.KeyCode
        local btn = KeybindLabels[oldKey]
        if btn then
            btn.Text = input.KeyCode.Name
            btn.TextColor3 = Theme.Accent2
            tween(btn, {BackgroundColor3 = Theme.BgSecondary}, 0.15)
        end
        listeningFor = nil
        return
    end
    
    if gpe then return end
    if Keybinds.ToggleUI ~= Enum.KeyCode.Unknown and input.KeyCode == Keybinds.ToggleUI then toggleUI() end
    if Keybinds.Fly ~= Enum.KeyCode.Unknown and input.KeyCode == Keybinds.Fly then toggleFly() end
    if Keybinds.Speed ~= Enum.KeyCode.Unknown and input.KeyCode == Keybinds.Speed then toggleSpeed() end
    if Keybinds.Noclip ~= Enum.KeyCode.Unknown and input.KeyCode == Keybinds.Noclip then toggleNoclip() end
    if input.KeyCode == Enum.KeyCode.Up then changeSpeed(CONFIG.StepSize) end
    if input.KeyCode == Enum.KeyCode.Down then changeSpeed(-CONFIG.StepSize) end
end)

