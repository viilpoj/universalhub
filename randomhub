local function destroyScript()
    -- 1. Desliga Voo
    if flying then
        flying = false
        stopFly()
    end
    
    -- 2. Desliga Speed
    if speeding then
        speeding = false
        stopSpeed()
    end
    
    -- 3. Desliga Noclip
    if noclipRunning then
        noclipRunning = false
        stopNoclip()
    end
    
    -- 4. Desliga Anti-AFK
    if antiAfkRunning then
        antiAfkRunning = false
        stopAntiAfk()
    end
    
    -- 5. Destrói a UI Grande
    pcall(function()
        if ScreenGui then ScreenGui:Destroy() end
    end)
    
    -- 6. Destrói o Botão Flutuante
    pcall(function()
        if SmallGui then SmallGui:Destroy() end
    end)
end

