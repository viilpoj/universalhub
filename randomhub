--// ==========================================
--// SISTEMA DE NOCLIP (CORRIGIDO)
--// ==========================================
local noclipRunning = false
local noclipConnection = nil

local function applyNoclipToChar()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CanCollide = false end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function restoreNoclip()
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

local function startNoclip()
    noclipRunning = true
    NoclipStatus.TextColor3 = Theme.Success
    NoclipStatus.Text = "NOCLIP  ✓"
    NoclipToggle.Text = "ATIVADO"
    NoclipGradient.Color = gradOn()
    applyNoclipToChar()
    if noclipConnection then noclipConnection:Disconnect() end
    noclipConnection = RunService.Heartbeat:Connect(function()
        if noclipRunning then
            applyNoclipToChar()
        end
    end)
end

local function stopNoclip()
    noclipRunning = false
    NoclipStatus.TextColor3 = Theme.Text
    NoclipStatus.Text = "NOCLIP"
    NoclipToggle.Text = "DESATIVADO"
    NoclipGradient.Color = gradOff()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    restoreNoclip()
end

local function toggleNoclip()
    if noclipRunning then stopNoclip() else startNoclip() end
end

NoclipToggle.MouseButton1Click:Connect(toggleNoclip)

