function updateSpeedUI()
    local ratio = (speed - CONFIG.MinSpeed) / (CONFIG.MaxSpeed - CONFIG.MinSpeed)
    SpeedValue.Text = tostring(math.floor(speed))
    tween(BarFill, {Size = UDim2.new(ratio, 0, 1, 0)}, 0.2)
    local c1, c2
    if ratio < 0.5 then
        c1, c2 = Theme.Accent1, Theme.Accent2
    elseif ratio < 0.85 then
        c1, c2 = Color3.fromRGB(255, 140, 60), Theme.Warning
    else
        c1, c2 = Color3.fromRGB(255, 70, 110), Theme.Danger
    end
    BarGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(1, c2),
    }
    tween(SpeedValue, {TextColor3 = c2}, 0.2)
end

local function changeSpeed(delta)
    speed = math.clamp(speed + delta, CONFIG.MinSpeed, CONFIG.MaxSpeed)
    updateSpeedUI()
end

MinusBtn.MouseButton1Click:Connect(function() changeSpeed(-CONFIG.StepSize) end)
PlusBtn.MouseButton1Click:Connect(function() changeSpeed(CONFIG.StepSize) end)

