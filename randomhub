local lastNpcSignature = ""

local function scanNPCs(force)
    local npcs = {}
    local seen = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) and not seen[obj] then
            seen[obj] = true
            table.insert(npcs, obj)
        end
    end
    
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local myPos = char.HumanoidRootPart.Position
        table.sort(npcs, function(a, b)
            local aP = a:FindFirstChild("HumanoidRootPart")
            local bP = b:FindFirstChild("HumanoidRootPart")
            if not aP or not bP then return false end
            return (myPos - aP.Position).Magnitude < (myPos - bP.Position).Magnitude
        end)
    end
    
    local sigParts = {}
    for i, npc in ipairs(npcs) do
        if i > 100 then break end
        table.insert(sigParts, npc.Name .. "|" .. npc:GetDebugId())
    end
    local newSig = table.concat(sigParts, ",")
    
    if newSig == lastNpcSignature and not force then
        if #npcs == 0 then
            NpcCount.Text = "Nenhum NPC encontrado"
            NpcCount.TextColor3 = Theme.Danger
        else
            NpcCount.Text = #npcs .. " NPC(s) no mapa"
            NpcCount.TextColor3 = Theme.Success
        end
        return
    end
    
    lastNpcSignature = newSig
    
    for _, child in ipairs(NpcInner:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local limit = math.min(#npcs, 100)
    for i = 1, limit do createNpcRow(npcs[i], i) end
    
    if #npcs == 0 then
        NpcCount.Text = "Nenhum NPC encontrado"
        NpcCount.TextColor3 = Theme.Danger
    else
        NpcCount.Text = #npcs .. " NPC(s) no mapa"
        NpcCount.TextColor3 = Theme.Success
    end
end

task.spawn(function()
    task.wait(0.5)
    scanNPCs(true)
    while true do
        task.wait(CONFIG.AutoScanInterval)
        pcall(scanNPCs)
    end
end)

