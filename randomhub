local currentTab = nil
local function switchTab(name)
    if currentTab == name then return end
    currentTab = name
    for tabName, tabData in pairs(tabs) do
        if tabName == name then
            tween(tabData.btn, {BackgroundTransparency = 0.2, BackgroundColor3 = Theme.Card}, 0.15)
            tabData.indicator.Visible = true
        else
            tween(tabData.btn, {BackgroundTransparency = 1}, 0.15)
            tabData.indicator.Visible = false
        end
    end
    for pageName, page in pairs(pages) do
        page.Visible = (pageName == name)
    end
end

local function setupTabHover(name)
    local t = tabs[name]
    t.btn.MouseEnter:Connect(function()
        if currentTab ~= name then
            tween(t.btn, {BackgroundTransparency = 0.7, BackgroundColor3 = Theme.Card}, 0.12)
        end
    end)
    t.btn.MouseLeave:Connect(function()
        if currentTab ~= name then
            tween(t.btn, {BackgroundTransparency = 1}, 0.12)
        end
    end)
    t.btn.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
end

